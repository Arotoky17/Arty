# =============================================================================
# Arty - Configuration Environment
# =============================================================================
# Copier ce fichier vers .env et adapter les valeurs

# --- Application ---
APP_NAME=Arty
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Diagnostic des décisions de trading (observabilité) ---
# Active le TradeDecisionDebugger : enregistre chaque opportunité, ses étapes,
# ses raisons de rejet et produit des statistiques par symbole.
# N'affecte AUCUNE règle de trading (pure observation).
DECISION_DIAGNOSTICS_ENABLED=false
# Nombre d'opportunités entre deux résumés périodiques (logs).
DECISION_DIAGNOSTICS_INTERVAL=100

# --- Trading Mode (ANALYSIS par défaut - LIVE désactivé) ---
# Valeurs possibles : analysis | paper | demo | live
# - analysis : Aucune position, uniquement les analyses
# - paper    : Simulation complète, aucun ordre MT5
# - demo     : Connexion réelle au compte DÉMO MT5 + exécution réelle des ordres
#              (aucun argent réel - ne nécessite PAS ALLOW_LIVE_TRADING=true)
# - live     : Trading réel (nécessite ALLOW_LIVE_TRADING=true)
#
# >>> POUR UN COMPTE DÉMO : TRADING_MODE=demo <<<
# Le bot se connectera au compte défini par MT5_LOGIN/MT5_PASSWORD/MT5_SERVER
# et exécutera de vrais ordres sur CE compte démo. Garde-fou : si le compte
# connecté est réel, le trading est automatiquement bloqué.
TRADING_MODE=analysis
ALLOW_LIVE_TRADING=false

# --- MetaTrader 5 ---
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=60000

# --- Symboles par défaut (séparés par virgule) ---
ACTIVE_SYMBOL=XAUUSD
DEFAULT_SYMBOLS=XAUUSD
CONTEXT_TIMEFRAME=H4
HTF_TIMEFRAME=H1
SETUP_TIMEFRAME=M5
ENTRY_TIMEFRAME=M5
DEFAULT_TIMEFRAME=H1

# --- Gestion du risque ---
RISK_PER_TRADE=0.01
MAX_DAILY_RISK=0.03
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=3
ONE_TRADE_PER_SYMBOL=true
# Spread maximum autorisé en points - au-delà, le trade est bloqué
MAX_SPREAD_POINTS=200

# --- Générateur de signaux ---
# Confiance minimale pour accepter un signal (0-1, défaut 0.85)
SIGNAL_MIN_CONFIDENCE=0.85
# Stratégie active pendant le développement (seule autorisée à générer des signaux)
# Valeurs possibles : SMC Trend Following | Breakout | Momentum | Reversal | Scalping | Swing Trading
SIGNAL_ACTIVE_STRATEGY=SMC Trend Following

# --- Validateur de signaux ---
# Ratio risque/rendement minimum pour valider un signal (défaut 1.5)
VALIDATOR_MIN_RR=1.5
# Spread maximum autorisé en points (défaut 20)
VALIDATOR_MAX_SPREAD=200
# Vérifier l'alignement de la tendance HTF (défaut true)
VALIDATOR_HTF_ALIGNMENT=true
# Vérifier le filtre de news — bloque les trades pendant les news (défaut true)
VALIDATOR_NEWS_FILTER=true
# Nombre min de confluences SMC à valider (FVG / Order Block / Liquidity Sweep /
# Premium-Discount). Les confluences sont comptées, pas bloquantes (0-4).
# Valeur recommandée pour laisser passer des trades propres : 2
VALIDATOR_MIN_CONFLUENCE=2

# --- Moteur de décision ICT/SMC ---
# Score minimal sur 100 : 60 faible, 80 valide, 90 premium.
DECISION_ENGINE_ENABLED=true
MINIMUM_SCORE=80
RISK_REWARD=2.0
ENABLE_MTF=true
ENABLE_NEWS_FILTER=true
ENABLE_KILL_ZONE=true
ENABLE_SPREAD_FILTER=true
ENABLE_PREMIUM_DISCOUNT=true
ENABLE_ATR_FILTER=true
MAXIMUM_SPREAD=200
ATR_PERIOD=14
MIN_ATR=0.0
MAX_ATR=999999.0
ATR_MULTIPLIER=1.0

# --- Suivi actif des positions (multiples de R) ---
# Activé par défaut : break-even + TP partiel + trailing stop
POSITION_MANAGER_ENABLED=true
ENABLE_BREAK_EVEN=true
ENABLE_PARTIAL_TP=true
ENABLE_TRAILING_STOP=true
BREAK_EVEN_AT_R=1.0
PARTIAL_TP_AT_R=2.0
PARTIAL_CLOSE_PERCENT=0.5
TRAILING_AT_R=3.0
TRAILING_DISTANCE_R=1.0

# --- Journal des trades ---
ENABLE_TRADE_JOURNAL=true
TRADE_JOURNAL_DIRECTORY=data/journal

# =============================================================================
# Phase 12 — Qualité des Order Blocks (Grade A/B/C/D) + confirmation M5
# =============================================================================
# Gate historique de création de setups, désactivé par défaut.
# Avec OB_QUALITY_ENABLED=true, chaque OB est noté pour la création de setup :
#   Grade A >= 85  |  Grade B >= 70  |  Grade C >= 50  |  Grade D < 50
# Seuls les OB dont le grade >= OB_MIN_GRADE deviennent des setups, et le signal
# n'est produit qu'après confirmation M5 (retest de la zone + bougie de rejet,
# optionnellement avec displacement).
OB_QUALITY_ENABLED=false
# Filtre SMC actif : exige Grade A/B, fraîcheur tracker et confirmation M5.
USE_OB_QUALITY_FILTER=true
# Score minimal du scorer détaillé (0-1).
OB_MIN_SCORE=0.55
# R/R plancher après sélection de l'OB.
OB_RR_MIN_GRADE_A=2.5
OB_RR_MIN_GRADE_B=2.0
# Grade minimum accepté pour créer un setup OB (A, B, C ou D).
OB_MIN_GRADE=B
# Exige une confirmation M5 (retest + rejet) avant tout signal OB.
OB_REQUIRE_M5_CONFIRMATION=true

# Seuils de grade (score 0-100).
OB_GRADE_A_THRESHOLD=85
OB_GRADE_B_THRESHOLD=70
OB_GRADE_C_THRESHOLD=50

# Pondérations de la notation (normalisées, la somme n'a pas besoin de valoir 100).
OB_WEIGHT_DISPLACEMENT=25
OB_WEIGHT_ZONE_HEIGHT=10
OB_WEIGHT_MITIGATION=10
OB_WEIGHT_FRESHNESS=10
OB_WEIGHT_TREND=15
OB_WEIGHT_CONFLUENCE=20
OB_WEIGHT_PREMIUM_DISCOUNT=10

# Paramètres de notation (distances en multiples d'ATR, jamais fixes).
OB_DISPLACEMENT_REFERENCE_ATR=1.2
OB_MIN_ZONE_HEIGHT_ATR=0.15
OB_MAX_ZONE_HEIGHT_ATR=3.0
OB_MAX_ZONE_AGE_BARS=25
OB_CONFLUENCE_LOOKBACK_BARS=30

# Confirmation M5.
OB_M5_LOOKBACK_BARS=30
OB_M5_MIN_REJECTION_RATIO=0.5
OB_M5_REQUIRE_DISPLACEMENT=true
OB_M5_DISPLACEMENT_ATR_MULT=1.0

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://arty:arty_secret@localhost:5432/arty_trading
DATABASE_URL_SYNC=postgresql://arty:arty_secret@localhost:5432/arty_trading

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=+261348896324
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# --- IA Assistant ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048

# --- Sessions de trading (UTC) ---
SESSION_ASIA_START=00:00
SESSION_ASIA_END=09:00
SESSION_LONDON_START=07:00
SESSION_LONDON_END=16:00
SESSION_NEWYORK_START=12:00
SESSION_NEWYORK_END=21:00


# ============================================================================
# IA Assistant (Phase 10)
# ============================================================================

# Provider IA : openai ou anthropic
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Anthropic (alternative)
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Parametres generaux
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
