# =============================================================================
# Arty - Configuration Environment
# =============================================================================
# Copier ce fichier vers .env et adapter les valeurs

# --- Application ---
APP_NAME=Arty
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Trading Mode (DEMO par défaut - REAL désactivé) ---
TRADING_MODE=demo
ALLOW_LIVE_TRADING=false

# --- MetaTrader 5 ---
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=60000

# --- Symboles par défaut (séparés par virgule) ---
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
DEFAULT_TIMEFRAME=H1

# --- Gestion du risque ---
RISK_PER_TRADE=0.01
MAX_DAILY_RISK=0.03
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=3
ONE_TRADE_PER_SYMBOL=true

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://arty:arty_secret@localhost:5432/arty_trading
DATABASE_URL_SYNC=postgresql://arty:arty_secret@localhost:5432/arty_trading

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# --- IA Assistant ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048

# --- Sessions de trading (UTC) ---
SESSION_ASIA_START=00:00
SESSION_ASIA_END=09:00
SESSION_LONDON_START=07:00
SESSION_LONDON_END=16:00
SESSION_NEWYORK_START=12:00
SESSION_NEWYORK_END=21:00
