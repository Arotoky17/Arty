# =============================================================================
# Arty - Configuration Environment
# =============================================================================
# Copier ce fichier vers .env et adapter les valeurs

# --- Application ---
APP_NAME=Arty
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Trading Mode (ANALYSIS par défaut - LIVE désactivé) ---
# Valeurs possibles : analysis | paper | demo | live
# - analysis : Aucune position, uniquement les analyses
# - paper    : Simulation complète, aucun ordre MT5
# - demo     : Connexion réelle au compte DÉMO MT5 + exécution réelle des ordres
#              (aucun argent réel - ne nécessite PAS ALLOW_LIVE_TRADING=true)
# - live     : Trading réel (nécessite ALLOW_LIVE_TRADING=true)
#
# >>> POUR UN COMPTE DÉMO : TRADING_MODE=demo <<<
# Le bot se connectera au compte défini par MT5_LOGIN/MT5_PASSWORD/MT5_SERVER
# et exécutera de vrais ordres sur CE compte démo. Garde-fou : si le compte
# connecté est réel, le trading est automatiquement bloqué.
TRADING_MODE=analysis
ALLOW_LIVE_TRADING=false

# --- MetaTrader 5 ---
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=60000

# --- Symboles par défaut (séparés par virgule) ---
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
DEFAULT_TIMEFRAME=M5

# --- Gestion du risque ---
RISK_PER_TRADE=0.01
MAX_DAILY_RISK=0.03
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=5
MAX_CONSECUTIVE_LOSSES=3
ONE_TRADE_PER_SYMBOL=true
# Spread maximum autorisé en points - au-delà, le trade est bloqué
MAX_SPREAD_POINTS=30

# --- Générateur de signaux ---
# Confiance minimale pour accepter un signal (0-1, défaut 0.85)
SIGNAL_MIN_CONFIDENCE=0.85
# Stratégie active pendant le développement (seule autorisée à générer des signaux)
# Valeurs possibles : SMC Trend Following | Breakout | Momentum | Reversal | Scalping | Swing Trading
SIGNAL_ACTIVE_STRATEGY=SMC Trend Following

# --- Validateur de signaux ---
# Ratio risque/rendement minimum pour valider un signal (défaut 1.5)
VALIDATOR_MIN_RR=1.5
# Spread maximum autorisé en points (défaut 20)
VALIDATOR_MAX_SPREAD=20
# Vérifier l'alignement de la tendance HTF (défaut true)
VALIDATOR_HTF_ALIGNMENT=true
# Vérifier le filtre de news — bloque les trades pendant les news (défaut true)
VALIDATOR_NEWS_FILTER=true

# --- Moteur de décision ICT/SMC ---
# Score minimal sur 100 : 60 faible, 80 valide, 90 premium.
DECISION_ENGINE_ENABLED=true
MINIMUM_SCORE=80
RISK_REWARD=2.0
ENABLE_MTF=true
ENABLE_NEWS_FILTER=true
ENABLE_KILL_ZONE=true
ENABLE_SPREAD_FILTER=true
ENABLE_PREMIUM_DISCOUNT=true
ENABLE_ATR_FILTER=true
MAXIMUM_SPREAD=20
ATR_PERIOD=14
MIN_ATR=0.0
MAX_ATR=999999.0
ATR_MULTIPLIER=1.0

# --- Suivi actif des positions (multiples de R) ---
# Activé par défaut : break-even + TP partiel + trailing stop
POSITION_MANAGER_ENABLED=true
ENABLE_BREAK_EVEN=true
ENABLE_PARTIAL_TP=true
ENABLE_TRAILING_STOP=true
BREAK_EVEN_AT_R=1.0
PARTIAL_TP_AT_R=2.0
PARTIAL_CLOSE_PERCENT=0.5
TRAILING_AT_R=3.0
TRAILING_DISTANCE_R=1.0

# --- Journal des trades ---
ENABLE_TRADE_JOURNAL=true
TRADE_JOURNAL_DIRECTORY=data/journal

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://arty:arty_secret@localhost:5432/arty_trading
DATABASE_URL_SYNC=postgresql://arty:arty_secret@localhost:5432/arty_trading

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=+261348896324
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# --- IA Assistant ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048

# --- Sessions de trading (UTC) ---
SESSION_ASIA_START=00:00
SESSION_ASIA_END=09:00
SESSION_LONDON_START=07:00
SESSION_LONDON_END=16:00
SESSION_NEWYORK_START=12:00
SESSION_NEWYORK_END=21:00


# ============================================================================
# IA Assistant (Phase 10)
# ============================================================================

# Provider IA : openai ou anthropic
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Anthropic (alternative)
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Parametres generaux
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
